erDiagram
    clinic |o--o{ patient : "clinicnum"
    clinic |o--o{ procedurelog : "clinicnum"
    patient ||--o{ procedurelog : "patnum"
    procedurecode ||--o{ procedurelog : "codenum"
    definition |o--o{ procedurelog : "dx = defnum (diagnosis list)"
    patient ||--o{ treatplan : "patnum"
    treatplan ||--o{ proctp : "treatplannum"
    procedurelog ||--o{ proctp : "procnumorig: one procedure, many copies"
    definition |o..o{ proctp : "dx text = itemname (name, not a key)"
    patient ||--o{ perioexam : "patnum"
    perioexam ||--o{ periomeasure : "perioexamnum"
    patient ||--o{ toothinitial : "patnum"
    patient ||--o{ disease : "patnum"
    diseasedef ||--o{ disease : "diseasedefnum"
    patient ||--o{ patient_tooth : "patnum = patient_id"
    procedurelog ||--o| planned_extraction : "procnum = procedure_id (procstatus 1)"
    planned_extraction }o..o| patient_tooth : "labels planned teeth"
    periomeasure }o..o| patient_tooth : "measures before the loss"
    patient_tooth ||..o| tooth_loss_truth : "scored against (evaluation only)"
    proctp }o..o{ tooth_loss_dq_check : "copies checked against the original"
    patient {
        bigint patnum PK "Open Dental patient key"
        date birthdate "age is computed from this, never stored"
        int gender "PatientGender enum"
        int patstatus "PatientStatus enum"
        bigint clinicnum FK "the office; 0 when the practice uses no clinics"
        bigint priprov "primary provider"
        date datefirstvisit "set by the software"
        string smokingsnomed "latest smoking status, SNOMED code"
        string zip "postcode; a real extract keeps at most the first 3 digits"
        bigint guarantor FK "head of household (patient.patnum)"
        string medurgnote "free-text medical alert"
        boolean premed "needs premedication before appointments"
        string language "primary language code"
        date admitdate "hospital admission date; can precede the first visit"
        bigint sitenum "place of care (school, nursing home); 0 when none"
        bigint responsparty FK "responsible for finances (patient.patnum)"
        timestamp datetimedeceased "date of death"
    }
    clinic {
        bigint clinicnum PK "office key"
        string description "office name (synthetic)"
        string abbr "short name"
        string address "street address"
        string address2 "second address line"
        string city "city"
        string state "state"
        string zip "postcode"
        string phone "phone"
        string fax "fax"
    }
    procedurelog {
        bigint procnum PK "procedure key"
        bigint patnum FK "patient"
        int procstatus "1 planned (TP) · 2 complete · 4 existing, other provider · 6 deleted · ..."
        date procdate "date shown as performed; planned: date planned or empty"
        date datetp "when first planned"
        date datecomplete "when set complete"
        bigint codenum FK "the procedure code (key, not text)"
        string toothnum "1–32, A–T primary; blank for mouth-level"
        string surf "surfaces, quadrant, sextant or arch"
        bigint dx FK "diagnosis: an item in the practice's own list (definition, category Diagnosis)"
        bigint prognosis FK "prognosis item (definition, category Prognosis)"
        string diagnosticcode "ICD code, only when sent with a medical claim; rare; a check, never the label"
        int icdversion "9 or 10: which ICD diagnosticcode is"
        bigint provnum "provider"
        bigint clinicnum FK "office"
        bigint aptnum "the appointment"
        double procfee "fee"
        string toothrange "teeth of a multi-tooth procedure, comma-separated"
        bigint priority FK "treatment priority (definition)"
        int placeservice "where it was done: office, school, nursing facility, mobile unit, ..."
        string prosthesis "blank no · I initial · R replacement"
        string medicalcode "optional medical procedure code"
        int unitqty "units billed, 1 by default"
        bigint sitenum "place of care"
    }
    procedurecode {
        bigint codenum PK "code key"
        string proccode "the D-code; extractions D7140, D7210"
        string descript "standard description"
        string abbrdesc "abbreviation"
        int treatarea "tooth · surface · quadrant · arch · mouth"
        bigint proccat FK "procedure category (definition)"
        boolean isprosth "crown, bridge, denture or partial"
        boolean ishygiene "a hygiene procedure"
        string medicalcode "a matching medical code, optional"
        boolean isradiology "a radiology procedure"
    }
    treatplan {
        bigint treatplannum PK "plan key"
        bigint patnum FK "patient"
        date datetp "date of the plan"
        int tpstatus "0 saved · 1 active · 2 inactive"
        string signature "captured when the plan is signed; empty when unsigned"
    }
    proctp {
        bigint proctpnum PK "copy key"
        bigint treatplannum FK "the plan it was copied into"
        bigint patnum FK "patient"
        bigint procnumorig FK "the procedurelog row it copies: count planned procedures there, not here"
        string toothnumtp "tooth, as display text: can differ from the original"
        string proccode "code as text, not a key: editable, can differ from procedurecode"
        string descript "description as text: editable"
        string dx "diagnosis as text (the item's name when saved), not a key: matched by name"
        string prognosis "prognosis as text"
        int itemorder "order within the plan, fixed when saved"
        bigint priority FK "treatment priority (definition)"
        string surf "surfaces, quadrant or arch, as text"
        string procabbr "code abbreviation as text; editable"
        bigint provnum "provider"
        date datetp "date planned"
        bigint clinicnum FK "office"
    }
    definition {
        bigint defnum PK "item key"
        int category "which list: Diagnosis, Prognosis, ..."
        string itemname "the item's text, e.g. a diagnosis; older and newer lists both stay"
        string itemvalue "extra information, used differently per list"
        int itemorder "place in the list, from 0"
        boolean ishidden "hidden: retired items keep their keys"
    }
    perioexam {
        bigint perioexamnum PK "exam key"
        bigint patnum FK "patient"
        date examdate "exam date"
        bigint provnum "examining provider"
    }
    periomeasure {
        bigint periomeasurenum PK "measure key"
        bigint perioexamnum FK "exam"
        int sequencetype "0 mobility · 1 furcation · 2 gingival margin · 4 probing · 6 bleeding bit-flags; CAL (7) is never stored"
        int inttooth "tooth 1–32"
        int toothvalue "whole-tooth measures (mobility); silver reads -1 as not measured"
        int mbvalue "mesiobuccal site; silver: -1 → null, margins of 100+ → negative"
        int bvalue "buccal site"
        int dbvalue "distobuccal site"
        int mlvalue "mesiolingual site"
        int lvalue "lingual site"
        int dlvalue "distolingual site"
    }
    toothinitial {
        bigint toothinitialnum PK "key"
        bigint patnum FK "patient"
        string toothnum "tooth"
        int initialtype "0 missing (no reason, no date) · 1 hidden · 2 primary · ..."
        double movement "shift in mm, or rotation or tipping in degrees"
    }
    disease {
        bigint diseasenum PK "key"
        bigint patnum FK "patient"
        bigint diseasedefnum FK "the problem"
        int probstatus "0 active · 1 resolved · 2 inactive"
        date datestart "may be empty"
        date datestop "may be empty"
        string patnote "free-text note on the problem"
    }
    diseasedef {
        bigint diseasedefnum PK "key"
        string diseasename "problem name"
        string icd10code "ICD-10-CM; diabetes is E10–E11"
        string snomedcode "SNOMED code"
        string icd9code "ICD-9 code"
        boolean ishidden "hidden from the list"
    }
    patient_tooth {
        bigint patient_id PK, FK "patient.patnum"
        bigint tooth_num PK "universal tooth number 1–32"
        string tooth_status_code "present · extracted_perio · extracted_other · extracted_no_dx · missing_at_entry · planned_perio · planned_other"
        date loss_date "extraction date; null when missing at entry or only planned"
        string label_source_code "completed · planned · none: which record gave the label"
        bigint dx_def_id FK "the mapped diagnosis item (definition.defnum)"
        boolean is_perio_loss "the label: diagnosis maps to periodontal; null when no diagnosis"
        date last_exam_date "last perio exam before the loss"
        double last_max_pd_mm "the tooth's own deepest probing before the loss"
        double last_max_cal_mm "own CAL = probing + gingival margin, before the loss"
        double last_bop_pct "own sites bleeding, 0–100"
        string last_mobility_code "own mobility grade 0–3"
        double neighbour_max_cal_mm "worst CAL on the teeth either side"
        double mouth_cal5_site_pct "sites with CAL ≥ 5 mm at the first exam, 0–100"
        bigint teeth_missing_at_entry_count "teeth already missing at the first exam"
        string tooth_type_code "incisor · canine · premolar · molar, upper or lower"
        boolean is_smoker "patient.smokingsnomed"
        boolean is_diabetic "a disease row with E10–E11"
        string run_id "Databricks job run id"
        timestamp run_ts "when the job wrote the row"
        string git_commit_sha "commit the job was deployed from"
    }
    planned_extraction {
        bigint procedure_id PK, FK "procedurelog.procnum"
        bigint patient_id FK "patient.patnum"
        bigint tooth_num "tooth 1–32"
        bigint dx_def_id FK "diagnosis item on the procedure"
        bigint plan_copy_count "proctp copies carrying it, across plans and exams"
        date first_plan_date "earliest plan date"
        date last_plan_date "latest plan date"
        boolean is_completed "procstatus became 2"
        date complete_date "datecomplete, when completed"
        string run_id "Databricks job run id"
        timestamp run_ts "when the job wrote the row"
        string git_commit_sha "commit the job was deployed from"
    }
    tooth_loss_dq_check {
        string check_name PK "e.g. proctp_code_differs, dx_item_from_retired_list"
        string run_id PK "Databricks job run id"
        string domain_code "completeness · accuracy · consistency · plan_copy · list_in_use"
        bigint check_num "check number after Kookal et al. 2024; null for checks added here"
        string table_name "the Open Dental table checked"
        bigint found_count "rows found"
        double found_ratio "share of rows, 0–1"
        boolean is_flagged "beyond its threshold"
        timestamp run_ts "when the check ran"
        string git_commit_sha "commit the job was deployed from"
    }
    tooth_loss_truth {
        bigint patient_id PK "patient.patnum"
        bigint tooth_num PK "tooth 1–32"
        string true_reason_code "perio · other"
    }

<mxfile host="drawio"><diagram name="omop_silver_entity" id="omop_silver_entity"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;site&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per person and tooth (OHDSI dental proposal)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#FFF4C2;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;observation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per smoking status, and per tooth missing at the chart's start&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1370" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;site_event&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per event tied to a tooth&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#FFF4C2;" vertex="1" parent="1"><mxGeometry x="350" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;condition_occurrence&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per diagnosis on a procedure, and per medical problem&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="690" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;person&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per patient&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1370" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;concept&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per concept: CDT, SNOMED, ICD10CM, and DENTAL_LOCAL for the practice's items&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#EFE9FB;" vertex="1" parent="1"><mxGeometry x="10" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;procedure_occurrence&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per completed procedure: planned ones have no place here&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="350" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;care_site&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per office&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1370" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;measurement&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per site measure per exam: probing, gingival margin, mobility, furcation, bleeding&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strok
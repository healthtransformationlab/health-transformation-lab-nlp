<mxfile host="drawio"><diagram name="opendental_silver_entity" id="opendental_silver_entity"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;tooth_loss_dq_check&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per data-quality check and run (Kookal et al. 2024, plus plan-copy checks)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E3F1E4;" vertex="1" parent="1"><mxGeometry x="350" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;cdcrec&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per CDC race and ethnicity code, in a hierarchy&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="690" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;allergydef&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per allergen: a drug (medicationnum) or another substance (uniicode)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1370" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;medication&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per medication, generics and brands both&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="2050" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;snomed&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per SNOMED code (a licensed list; an extract may hold only the codes it uses)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="2390" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;carrier&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per insurance carrier (name and address)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="2730" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;insplan&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per insurance plan; subscribers share plans through inssub&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="3070" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;inssub&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per subscriber to a plan: who holds it&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="3410" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;tooth_loss_dq_group&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per group, measure and run: is the perio chart kept as well for every group of patients?&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E3F1E4;" vertex="1" parent="1"><mxGeometry x="3750" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;perioexam&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per periodontal exam&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="4770" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;patientrace&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per patient and race or ethnicity code (a patient can have several)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1030" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;allergy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per allergy a patient has&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1370" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;medicationpat&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per medication a patient takes, for a period&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1710" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;ehrmeasureevent&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per measure event, e.g. a tobacco use assessment&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="2050" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;vitalsign&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per vitals reading&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="2390" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;toothinitial&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per tooth state at the chart's start&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="3070" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;sheet&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per filled-in form, e.g. an exam form&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="3410" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;sheetfield&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per answer on a form&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="3750" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;patplan&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per patient and plan covering them: what determines a patient's coverage&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="4430" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;patient_tooth&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per patient and tooth (1–32): how it was lost, and what was charted before&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#FFF4C2;" vertex="1" parent="1"><mxGeometry x="4770" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;periomeasure&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per exam, tooth and kind of measure (six sites as columns)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="5110" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;procnote&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per note on a procedure; not every procedure has one&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="350" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;proctp&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per planned procedure per saved plan: a copy, repeated in every plan and at later exams&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="690" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;definition&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per item in the practice's own lists (diagnoses, prognoses, ...)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1030" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;document&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per image in a patient's folder; radiographs are ImgType 1&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1370" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;radiograph_bone_level&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;SIMULATED: one per radiograph and tooth on it, read for bone loss; stands in for a radiograph-reading tool (Open Dental stores no reading)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#FFF4C2;" vertex="1" parent="1"><mxGeometry x="1710" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;patfield&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per practice-defined patient field, e.g. research consent&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="2050" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;patient&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per patient&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="2730" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;tooth_loss_truth&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per patient and missing tooth: the generator's true reason; evaluation only, never a feature&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E4E7EA;" vertex="1" parent="1"><mxGeometry x="4090" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;appointment&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per scheduled visit&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="4770" y="322" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;procedurecode&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per procedure code: fixed meaning (CDT D-codes)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="10" y="478" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;procedurelog&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per procedure, done or planned: the one record of each&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="690" y="478" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;treatplan&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per saved treatment plan; several can share a date (alternatives)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="1030" y="478" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;diseasedef&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per problem in the list&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="2050" y="478" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;disease&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per patient medical problem&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="2390" y="478" width="220" height="56" as="geometry"></mxG
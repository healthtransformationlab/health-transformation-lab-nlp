<mxfile host="drawio"><diagram name="opendental_silver_entity" id="opendental_silver_entity"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;tooth_loss_dq_check&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per data-quality check and run (Kookal et al. 2024, plus plan-copy checks)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E3F1E4;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;procedurecode&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per procedure code: fixed meaning (CDT D-codes)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="350" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;planned_extraction&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per planned extraction in procedurelog, however many plan copies carry it&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#FFF4C2;" vertex="1" parent="1"><mxGeometry x="690" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;tooth_loss_truth&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per patient and missing tooth: the generator's true reason; evaluation only, never a feature&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E4E7EA;" vertex="1" parent="1"><mxGeometry x="1030" y="10" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;proctp&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per planned procedure per saved plan: a copy, repeated in every plan and at later exams&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="10" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;definition&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per item in the practice's own lists (diagnoses, prognoses, ...)&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="350" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;procedurelog&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per procedure, done or planned: the one record of each&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#E1EEF6;" vertex="1" parent="1"><mxGeometry x="690" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;patient_tooth&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5B6B73'&gt;One per patient and tooth (1–32): how it was lost, and what was charted before&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#1B3139;strokeWidth=1.5;fontColor=#1B3139;fontSize=13;fillColor=#FFF4C2;" vertex="1" parent="1"><mxGeometry x="1030" y="166" width="220" height="56" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;p